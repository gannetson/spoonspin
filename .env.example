# production | development — set production on the live server (secure cookies)
NODE_ENV=development
# OpenAI — used to confirm community recipe/restaurant suggestions
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Apify — admin discovery (Thuisbezorgd / Uber Eats order options + Tripadvisor restaurants)
# Token from https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Optional actor overrides (defaults shown):
# APIFY_THUISBEZORGD_ACTOR=jarvismoney/thuisbezorgd-takeaway-scraper
# APIFY_UBEREATS_ACTOR=borderline/uber-eats-scraper-ppr
# APIFY_TRIPADVISOR_ACTOR=meticulous_snail/tripadvisor-restaurant-leads
# auto | mapbox | google  (used only when local Postgres has no matches)
RESTAURANT_PROVIDER=auto
# Set to 1 only if you want Mapbox/Google when curated DB has no match.
# Off by default — live POI search returns unrelated Leiden junk for many cuisines.
# RESTAURANT_LIVE_FALLBACK=0
# Postgres — passwordless peer auth via Unix socket (recommended on the server):
DATABASE_URL=postgresql:///spoonspin?host=/var/run/postgresql
# Or TCP with password:
# DATABASE_URL=postgresql://spoonspin:PASSWORD@localhost:5432/spoonspin
# Do NOT use postgresql://localhost/... without a password (triggers SCRAM errors).
# TEST_DATABASE_URL=postgresql://localhost:5432/spoonspin_test
API_PORT=3007
# Public app origin (used for OAuth redirects back into the SPA)
# Local:
APP_URL=http://localhost:5173
# Production (required for Google login):
# APP_URL=https://spoonspin.nl
# Google Sign-In (OAuth Web client). Authorized redirect URIs must include:
#   http://localhost:5173/api/auth/google/callback
#   https://spoonspin.nl/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to APP_URL + /api/auth/google/callback
# GOOGLE_REDIRECT_URI=
# Apple Sign-In — add when ready (Services ID + key)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
GOOGLE_PLACES_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Optional Tripadvisor Content API key for guest-rating enrichment
# TRIPADVISOR_API_KEY=
# Awin — Thuisbezorgd.nl NL affiliate (client-side; Vite embeds at build time)
# Publisher ID from https://ui.awin.com/ (awinaffid). Required for tracked order links after cookie consent.
VITE_AWIN_PUBLISHER_ID=
# Optional override; defaults to Thuisbezorgd.nl NL programme MID 10510
# VITE_AWIN_THUISBEZORGD_MID=10510
