GOOGLE_PLACES_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Optional Tripadvisor Content API key for guest-rating enrichment
# TRIPADVISOR_API_KEY=
# OpenAI — used to confirm community recipe/restaurant suggestions
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Shared secret for /admin review UI (send as x-admin-token or ?token=)
ADMIN_TOKEN=
# auto | mapbox | google  (used only when local SQLite has no matches)
RESTAURANT_PROVIDER=auto
# Set to 1 only if you want Mapbox/Google when curated DB has no match.
# Off by default — live POI search returns unrelated Leiden junk for many cuisines.
# RESTAURANT_LIVE_FALLBACK=0
# RESTAURANTS_DB_PATH=data/restaurants.sqlite
API_PORT=3001
