# production | development — set production on the live server (secure cookies)
NODE_ENV=development
# OpenAI — used to confirm community recipe/restaurant suggestions
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Built-in task defaults (eligible for OpenAI's small-model sharing allowance).
# Explicit per-task settings override OPENAI_MODEL; a global override overrides
# all built-in defaults. Leave OPENAI_MODEL unset to use the cheaper task routing.
# OPENAI_MODEL_RESTAURANT_COMPLETION=gpt-4.1-nano
# OPENAI_MODEL_RESTAURANT_VERIFY=gpt-4o-mini
# OPENAI_MODEL_RECIPE_COMPLETION=gpt-4o-mini
# OPENAI_MODEL_IMAGE_QUERY=gpt-4.1-nano
# OPENAI_MODEL_CONTENT_COMPLETION=gpt-4.1-nano
# OPENAI_MODEL_REVIEW_SEARCH=gpt-4.1-mini
# Free daily tokens require input/output sharing enabled for the API key's
# project in the eligible organization. This shares prompts/responses for model
# improvement. Eligibility alone is not enrollment; keep a positive balance.
# Tool fees (including web search) and over-quota requests can still be billed.
# See docs/openai-costs.md for activation and verification.
# Apify — admin discovery (Thuisbezorgd / Uber Eats order options + Tripadvisor restaurants)
# Token from https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Optional actor overrides (defaults shown):
# APIFY_THUISBEZORGD_ACTOR=jarvismoney/thuisbezorgd-takeaway-scraper
# APIFY_UBEREATS_ACTOR=borderline/uber-eats-scraper-ppr
# APIFY_TRIPADVISOR_ACTOR=meticulous_snail/tripadvisor-restaurant-leads
# auto | mapbox | google  (used only when local Postgres has no matches)
RESTAURANT_PROVIDER=auto
# Set to 1 only if you want Mapbox/Google when curated DB has no match.
# Off by default — live POI search returns unrelated Leiden junk for many cuisines.
# RESTAURANT_LIVE_FALLBACK=0
# Postgres — passwordless peer auth via Unix socket (recommended on the server):
DATABASE_URL=postgresql:///spoonspin?host=/var/run/postgresql
# Or TCP with password:
# DATABASE_URL=postgresql://spoonspin:PASSWORD@localhost:5432/spoonspin
# Do NOT use postgresql://localhost/... without a password (triggers SCRAM errors).
# TEST_DATABASE_URL=postgresql://localhost:5432/spoonspin_test
API_PORT=3007
# Public app origin (used for OAuth redirects back into the SPA)
# Local:
APP_URL=http://localhost:5173
# Production (required for Google login):
# APP_URL=https://spoonspin.nl
# Google Sign-In (OAuth Web client). Authorized redirect URIs must include:
#   http://localhost:5173/api/auth/google/callback
#   https://spoonspin.nl/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to APP_URL + /api/auth/google/callback
# GOOGLE_REDIRECT_URI=
# Apple Sign-In — add when ready (Services ID + key)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
GOOGLE_PLACES_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Optional Tripadvisor Content API key for guest-rating enrichment
# TRIPADVISOR_API_KEY=
# --- Reservations (NL) — see docs/reservations.md ---
# Master switch (default off). Google Places works independently.
# RESERVATIONS_ENABLED=false
# ZENCHEF_ENABLED=false
# GUESTPLAN_ENABLED=false
# THEFORK_ENABLED=false
# Zenchef partner API (docs + credentials via Zenchef partnership — not public)
# ZENCHEF_API_KEY=
# ZENCHEF_PARTNER_ID=
# Guestplan partner API (contact Guestplan — no public booking API docs yet)
# GUESTPLAN_API_KEY=
# TheFork B2B (Auth0 client credentials from integrations@thefork.com)
# THEFORK_CLIENT_ID=
# THEFORK_CLIENT_SECRET=
# Optional affiliate/source id — never hard-code
# THEFORK_AFFILIATE_ID=
# Awin — Thuisbezorgd.nl NL affiliate
# Publisher ID from https://ui.awin.com/ (awinaffid). Required for tracked order links
# after marketing cookie consent. Read at API runtime (/api/public-config) — restart is enough;
# VITE_ prefix also works for local Vite builds.
AWIN_PUBLISHER_ID=
# Or: VITE_AWIN_PUBLISHER_ID=
# Optional override; defaults to Thuisbezorgd.nl NL programme MID 10510
# AWIN_THUISBEZORGD_MID=10510
# VITE_AWIN_THUISBEZORGD_MID=10510
