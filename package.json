{
  "name": "spoonspin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite --port 5173 --strictPort\"",
    "dev:client": "vite --port 5173 --strictPort",
    "server": "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "vitest run src/content/countries/content.test.ts",
    "content:wikipedia": "tsx --tsconfig tsconfig.app.json scripts/fetch-wikipedia-cuisines.ts",
    "agent:dishes": "tsx --tsconfig tsconfig.app.json scripts/discover-wikipedia-dishes.ts",
    "agent:recipes": "tsx --tsconfig tsconfig.app.json scripts/enrich-recipes.ts",
    "agent:cuisine-images": "tsx --tsconfig tsconfig.app.json scripts/enrich-cuisine-images.ts",
    "agent:restaurant-photos": "tsx --tsconfig tsconfig.app.json scripts/enrich-restaurant-photos.ts",
    "agent:restaurants": "tsx --tsconfig tsconfig.app.json scripts/restaurant-agent.ts",
    "agent:gather": "tsx --tsconfig tsconfig.app.json scripts/gather-restaurants.ts",
    "agent:curate": "tsx --tsconfig tsconfig.app.json scripts/curate-restaurants.ts",
    "agent:proef": "tsx --tsconfig tsconfig.app.json scripts/import-proef-de-wereld.ts",
    "agent:ratings": "tsx --tsconfig tsconfig.app.json scripts/enrich-ratings.ts",
    "agent:review-links": "tsx --tsconfig tsconfig.app.json scripts/enrich-review-links.ts",
    "agent:compose-dinners": "tsx --tsconfig tsconfig.app.json scripts/compose-dinners.ts",
    "agent:complete-menus": "tsx --tsconfig tsconfig.app.json scripts/complete-cook-menus.ts",
    "db:rebuild-cuisines": "tsx --tsconfig tsconfig.app.json scripts/rebuild-cuisine-codes.ts",
    "db:export-content": "tsx --tsconfig tsconfig.app.json scripts/export-content.ts",
    "db:import-content": "tsx --tsconfig tsconfig.app.json scripts/import-content.ts",
    "db:seed-content": "tsx --tsconfig tsconfig.app.json scripts/seed-content.ts",
    "deploy:prod": "./deploy/remote-deploy.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^1.29.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.23.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
